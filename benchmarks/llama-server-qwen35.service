[Unit]
Description=Llama.cpp Server API (Qwen3.5-9B MTP Q4_0, least privilege)
After=network.target nvidia-persistenced.service nvidia-cuda-mps.service
Requires=nvidia-cuda-mps.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/libexec
Environment="LD_LIBRARY_PATH=/usr/local/libexec:/usr/local/cuda/lib64"
Environment="CUDA_MPS_ACTIVE_THREAD_PERCENTAGE=50"
Environment="CUDA_DEVICE_MAX_CONNECTIONS=1"
Environment="HOST=127.0.0.1"
Environment="PORT=8080"
ExecStart=/usr/local/bin/ws-gpu-task-50 /usr/local/libexec/start_llama_qwen35.sh
LimitMEMLOCK=infinity
LimitNOFILE=1048576
Nice=-11
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
MemoryMax=32G
TasksMax=256
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
