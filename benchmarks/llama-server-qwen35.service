[Unit]
Description=Llama.cpp Server API (Qwen3.5-9B Q4_0)
After=network.target nvidia-persistenced.service nvidia-cuda-mps.service
Requires=nvidia-cuda-mps.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/beellama.cpp
Environment="LD_LIBRARY_PATH=/usr/local/cuda/lib64"
Environment="CUDA_MPS_ACTIVE_THREAD_PERCENTAGE=50"
Environment="CUDA_DEVICE_MAX_CONNECTIONS=1"
Environment="HOST=0.0.0.0"
Environment="PORT=8080"
ExecStart=/usr/local/bin/ws-gpu-task-50 /root/start_llama.sh
LimitMEMLOCK=infinity
LimitNOFILE=1048576
Nice=-11
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
